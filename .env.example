# Copy to .env.local (gitignored) and fill in. Set the same vars in Vercel →
# Project → Settings → Environment Variables (changes there need a redeploy).
# None of these are NEXT_PUBLIC_* — nothing secret ever reaches the browser.

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role secret — server only, never expose

# Shared office passcode for the PIN gate (4-6 digits is plenty)
TEAM_PIN=1234

# Signs the PIN and identity cookies. Any long random string; generate one with
# `openssl rand -hex 32`. REQUIRED — with it unset the app fails closed and
# nobody can get past /pin. Changing it signs everyone out, which is also the
# way to revoke every device at once.
SESSION_SECRET=

# Shared secret for the scheduled Teams jobs. Vercel sends it as
# `Authorization: Bearer <secret>` to /api/cron/*; without it those routes
# refuse every request.
CRON_SECRET=

# Optional: Teams Workflows webhook URL (feature is silently off if unset)
TEAMS_WEBHOOK_URL=

# Optional: the app's public URL — used for the "Open the scoreboard" button
# on the Teams card
APP_URL=
